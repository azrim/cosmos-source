[
  {
    "name": "9Router",
    "description": "Smart AI routing gateway that manages API keys, subscriptions, and rate limits with 3-tier fallback for cost optimization.",
    "longDescription": "<p>Smart AI routing gateway that manages API keys, subscriptions, and rate limits with 3-tier fallback for cost optimization.</p>",
    "tags": [
      "ai",
      "router",
      "api",
      "gateway",
      "llm",
      "proxy",
      "cost-optimization"
    ],
    "repository": "https://github.com/decolua/9router",
    "image": "https://ghcr.io/decolua/9router",
    "supported_architectures": [
      "amd64",
      "arm64"
    ],
    "icon": "",
    "compose": "servapps/9Router/cosmos-compose.json",
    "config": {
      "minVersion": "0.7.6",
      "services": {
        "{ServiceName}": {
          "image": "ghcr.io/decolua/9router:latest",
          "container_name": "{ServiceName}",
          "hostname": "{ServiceName}",
          "restart": "unless-stopped",
          "environment": [
            "TZ=auto"
          ],
          "labels": {
            "cosmos-force-network-secured": "true",
            "cosmos-auto-update": "true",
            "cosmos-icon": "https://raw.githubusercontent.com/decolua/9router/main/icon.png"
          },
          "volumes": [
            {
              "source": "{DefaultDataPath}/9router/config",
              "target": "/app/config",
              "type": "bind"
            }
          ],
          "routes": [
            {
              "name": "{ServiceName}",
              "description": "Expose {ServiceName} to the web",
              "useHost": true,
              "target": "http://{ServiceName}:20128",
              "mode": "SERVAPP",
              "Timeout": 14400000,
              "ThrottlePerMinute": 12000,
              "BlockCommonBots": true,
              "SmartShield": {
                "Enabled": true
              }
            }
          ]
        }
      }
    }
  },
