  {
    "name": "Pi-hole",
    "description": "Pi-hole is a network-wide ad blocker that acts as a DNS sinkhole, protecting your devices from unwanted ads and trackers without installing any client-side software.",
    "longDescription": "<p>Pi-hole is a Linux network-level advertisement and Internet tracker blocking application which acts as a DNS sinkhole and optionally a DHCP server, intended for use on a private network. It is designed for low-power embedded devices with network capability, such as the Raspberry Pi, but can be installed on almost any Linux machine.</p><p>Pi-hole blocks ads for all devices on your network without requiring any client-side software. It features a beautiful web-based admin interface for managing and monitoring your DNS queries, blocklists, and whitelists. With Pi-hole, you can also see statistics about the DNS queries on your network, including the number of queries blocked and the domains most frequently accessed.</p>",
    "tags": [
      "dns",
      "ad-blocker",
      "network",
      "privacy",
      "sinkhole",
      "tracker-blocking",
      "pihole",
      "self-hosted"
    ],
    "repository": "https://github.com/pi-hole/pi-hole",
    "image": "https://hub.docker.com/r/pihole/pihole",
    "supported_architectures": [
      "amd64",
      "arm64"
    ],
    "icon": "",
    "compose": "servapps/Pihole/cosmos-compose.json",
    "config": {
      "cosmos-installer": {
        "form": [
          {
            "name": "webPassword",
            "label": "Set a password for the Pi-hole admin dashboard",
            "initialValue": "{Passwords.0}",
            "type": "text"
          }
        ]
      },
      "minVersion": "0.7.6",
      "services": {
        "{ServiceName}": {
          "image": "pihole/pihole:latest",
          "container_name": "{ServiceName}",
          "hostname": "{ServiceName}",
          "restart": "unless-stopped",
          "environment": [
            "TZ=auto",
            "WEBPASSWORD={Context.webPassword}",
            "DNSMASQ_LISTENING=all"
          ],
          "ports": [
            "53:53/tcp",
            "53:53/udp"
          ],
          "labels": {
            "cosmos-force-network-secured": "true",
            "cosmos-auto-update": "true",
            "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Pihole/icon.png"
          },
          "volumes": [
            {
              "source": "{DefaultDataPath}/pihole/etc-pihole",
              "target": "/etc/pihole",
              "type": "bind"
            },
            {
              "source": "{DefaultDataPath}/pihole/etc-dnsmasq.d",
              "target": "/etc/dnsmasq.d",
              "type": "bind"
            }
          ],
          "routes": [
            {
              "name": "{ServiceName}",
              "description": "Expose {ServiceName} admin to the web",
              "useHost": true,
              "target": "http://{ServiceName}:80",
              "mode": "SERVAPP",
              "Timeout": 14400000,
              "ThrottlePerMinute": 12000,
              "BlockCommonBots": true,
              "SmartShield": {
                "Enabled": true
              }
            }
          ]
        }
      }
    }
  },
